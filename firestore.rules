rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validQuote(q) {
      return q is map && q.keys().hasOnly(['normal', 'fast'])
        && q.normal is int && q.normal >= 0 && q.normal <= 10000
        && (q.get('fast', null) == null || (q.fast is int && q.fast >= 0 && q.fast <= 10000));
    }

    function isFree(d) {
      return 'delivery' in d && d.delivery.normal == 0 && d.delivery.get('fast', null) == null;
    }

    function validProfile(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 16
        && d.address is string && d.address.size() >= 10 && d.address.size() <= 500;
    }

    // users/{uid}: profile plus role ('user' or 'admin').
    // A role can only be changed by an admin or in the Firebase console.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'user'
        && validProfile(request.resource.data);

      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt'])
          && validProfile(request.resource.data))
        || isAdmin();

      allow delete: if false;
    }

    // carts/{uid}: each signed-in customer's basket.
    match /carts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'itemNotes', 'note', 'updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 100
        && (!('itemNotes' in request.resource.data)
          || (request.resource.data.itemNotes is map && request.resource.data.itemNotes.size() <= 100))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
    }

    // orders/{id}: created by the customer, status managed by admins.
    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'customer', 'items', 'note', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;

      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Admin: moves status and quotes delivery. An order can only go past 'new' once the
      // customer has accepted the delivery charge, or delivery is free.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusTimes', 'deliveryCharge', 'delivery', 'deliveryChoice', 'updatedAt'])
        && request.resource.data.status in ['new', 'confirmed', 'making', 'shipped', 'delivered', 'cancelled']
        && (request.resource.data.status in ['new', 'cancelled']
          || resource.data.status in ['confirmed', 'making', 'shipped', 'delivered']
          || resource.data.get('customerConfirmed', false) == true
          || isFree(request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['delivery', 'deliveryChoice'])
          || (resource.data.get('customerConfirmed', false) != true && validQuote(request.resource.data.delivery)))
        && (!('deliveryCharge' in request.resource.data)
          || request.resource.data.deliveryCharge == null
          || (request.resource.data.deliveryCharge is int && request.resource.data.deliveryCharge >= 0 && request.resource.data.deliveryCharge <= 10000));

      // Customer: accept one of the quoted delivery options, which confirms the order, or cancel before accepting.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status == 'new'
        && resource.data.get('customerConfirmed', false) != true
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryChoice', 'deliveryCharge', 'customerConfirmed', 'customerConfirmedAt', 'status', 'statusTimes', 'updatedAt'])
            && 'delivery' in resource.data
            && request.resource.data.customerConfirmed == true
            && request.resource.data.status == 'confirmed'
            && request.resource.data.deliveryChoice in ['normal', 'fast']
            && resource.data.delivery.get(request.resource.data.deliveryChoice, null) is int
            && request.resource.data.deliveryCharge == resource.data.delivery[request.resource.data.deliveryChoice])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusTimes', 'cancelledBy', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'customer'));

      allow delete: if false;
    }

    // Catalogue: anyone can read, only admins can change.
    match /sections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // reviews/{orderId_productId}: one review per product per delivered order, written by
    // the customer who placed that order. Anyone can read; admins can remove.
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'orderId', 'productId', 'name', 'rating', 'text', 'options', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.orderId + '_' + request.resource.data.productId
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (resource == null || resource.data.uid == request.auth.uid)
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'delivered';
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /combos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // meta/catalog: a version stamp admins bump on every catalogue change, so visitors
    // can reuse their cached catalogue when nothing changed.
    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // media/{id}: uploaded product photos, stored as compressed data URLs.
    match /media/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin();
    }
  }
}
